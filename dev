if [ -z "$VIRTUAL_ENV" ]; then
    echo "No virtual environment activated. Activating the default one."
    source .venv/bin/activate
elif [ "$(realpath .venv 2>/dev/null)" != "$(realpath $VIRTUAL_ENV)" ]; then
    echo "Switching to the default virtual environment."
    deactivate
    source .venv/bin/activate
fi

cd frontend && bun run dev