{
    "name": "pilk",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
        "dev:frontend": "next dev --turbo --port 8001",
        "dev:backend": "cd .. && python3.13 backend/main.py",
        "build": "next build",
        "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
        "start:frontend": "next start --port 8001",
        "start:backend": "cd .. && python3.13 backend/main.py",
        "lint": "next lint"
    },
    "dependencies": {
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-popover": "^1.1.14",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-tooltip": "^1.2.7",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.1.2",
        "input-otp": "^1.4.2",
        "lucide-react": "0.517.0",
        "motion": "^12.18.1",
        "next": "15.3.3",
        "next-themes": "^0.4.6",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "sonner": "^2.0.5",
        "tailwind-merge": "^3.3.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@tailwindcss/postcss": "^4.1.10",
        "@types/node": "24.0.1",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "eslint": "^9.29.0",
        "eslint-config-next": "15.3.3",
        "tailwindcss": "^4.1.10",
        "tw-animate-css": "^1.3.4",
        "typescript": "^5.8.3"
    }
}
